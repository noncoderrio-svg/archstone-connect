{
  "name": "archstone-connect",
  "private": true,
  "version": "1.0.0",
  "description": "Archstone CRM and WhatsApp marketing platform",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node server.js",
    "seed": "tsx server/seed.ts",
    "restore-backup": "tsx scripts/restore-backup.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/anek-latin": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.70.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "vite": "^8.3.6",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.6",
    "railway": "^3.16.0",
    "typescript": "^7.0.2"
  }
}
